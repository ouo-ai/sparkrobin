APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai
APIMART_VIDEO_MODEL=sora-2
APIMART_VIDEO_RESOLUTION=720p

# Required for BetterAuth Google sign-in.
BETTER_AUTH_URL=https://sparkrobin.ai
BETTER_AUTH_SECRET=
BETTER_AUTH_DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required for production video generation rate limiting.
# Supports either Upstash/Vercel Redis REST or a dedicated Postgres connection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
VIDEO_RATE_LIMIT_DATABASE_URL=
VIDEO_RATE_LIMIT_KEY_PREFIX=sparkrobin:video-generation
VIDEO_RATE_LIMIT_HASH_SALT=
